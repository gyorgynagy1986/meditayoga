// components/BookingWidget.tsx
// Timeify óralista widget beágyazása. Next/React alatt nem a script-loadert
// használjuk, hanem közvetlenül az iframe-eket rendereljük.
//
// KÉT IFRAME:
//   1. LISTA  — az oldal folyamában, a magassága a tartalmat követi
//               (timeify:embed:height), tehát a mi oldalunk görgeti.
//               Soha nem mozdul, nem változik a szélessége.
//   2. MODÁL  — rejtve előre betöltve, fixed inset-0. Foglalás gombra ezt
//               mutatjuk meg; a viewportja pontosan a mi viewportunk, ezért a
//               foglalási kártya valóban a képernyő közepén van, mobilon is.
//
// Miért nem elég egy iframe: egy több ezer px magas iframe-en belül a
// `position: fixed` a magas dobozra vonatkozik, nem a képernyőre — a modál a
// doboz közepére, azaz a látótéren kívülre kerülne.
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";

export default function BookingWidget({
  origin,
  slug,
  lang = "hu",
  days = 28,
}: {
  origin: string;
  slug: string;
  lang?: string;
  days?: number;
}) {
  const listRef = useRef<HTMLIFrameElement>(null);
  const modalRef = useRef<HTMLIFrameElement>(null);
  const [height, setHeight] = useState(520);
  const [modalOpen, setModalOpen] = useState(false);

  // A modál-iframe akkor "kész", amikor a benne futó alkalmazás felcsatolta a
  // message figyelőjét és szólt (timeify:modal:ready). Addig sorba állítjuk a
  // kattintást — enélkül egy gyors kattintás üzenete elveszne, mert az iframe
  // rejtve, jóval a kattintás előtt töltődik be.
  const modalReady = useRef(false);
  const queuedClassId = useRef<string | null>(null);

  // Az iframe-ek csak kliensen renderelnek: az src-be beletesszük a saját
  // originünket (?host=), amiből a widget tudja, kinek küldhet postMessage-et
  // és kitől fogadhat el üzenetet. Szerveren nincs window, ezért a mountig
  // egy azonos magasságú helyőrző áll a helyén — így nincs hidratálási eltérés.
  const [mounted, setMounted] = useState(false);
  useEffect(() => setMounted(true), []);

  // Normalizált origin: elviseli a záró perjelet és az útvonalat is.
  const target = useMemo(() => {
    try {
      return new URL(origin).origin;
    } catch {
      return origin;
    }
  }, [origin]);

  // A Timeify-on a magyar az alapértelmezett nyelv és PREFIX NÉLKÜL él
  // (/embed/<slug>); a /hu/embed/... 308-cal átirányulna, azaz minden betöltés
  // fölösleges extra kört tenne. Más nyelv kap prefixet.
  const basePath =
    lang === "hu"
      ? `/embed/${encodeURIComponent(slug)}`
      : `/${encodeURIComponent(lang)}/embed/${encodeURIComponent(slug)}`;

  const hostParam = mounted
    ? `&host=${encodeURIComponent(window.location.origin)}`
    : "";

  const listSrc = mounted ? `${target}${basePath}?days=${days}${hostParam}` : "";
  const modalSrc = mounted ? `${target}${basePath}?modal=1${hostParam}` : "";

  const sendOpen = useCallback(
    (classInstanceId: string | null) => {
      modalRef.current?.contentWindow?.postMessage(
        { type: "timeify:modal:open", slug, classInstanceId },
        target,
      );
    },
    [slug, target],
  );

  const closeModal = useCallback(() => {
    setModalOpen(false);
    modalRef.current?.contentWindow?.postMessage(
      { type: "timeify:modal:close", slug },
      target,
    );
  }, [slug, target]);

  useEffect(() => {
    const onMessage = (ev: MessageEvent) => {
      if (ev.origin !== target) return;
      const d = ev.data as {
        type?: string;
        slug?: string;
        height?: number;
        classInstanceId?: string;
      };
      if (d?.slug !== slug) return;

      const fromList = ev.source === listRef.current?.contentWindow;
      const fromModal = ev.source === modalRef.current?.contentWindow;
      if (!fromList && !fromModal) return;

      if (fromList) {
        if (d.type === "timeify:embed:height") {
          const h = Number(d.height);
          if (h > 0 && h < 50000) setHeight(h);
        } else if (d.type === "timeify:embed:openBooking") {
          // Visszajelzés: átvettük a modált (különben ~400 ms után a lista
          // maga nyitna egyet — ez a fallback régi gazdaoldalakhoz).
          listRef.current?.contentWindow?.postMessage(
            { type: "timeify:embed:bookingTaken", slug },
            target,
          );
          const id = d.classInstanceId ?? null;
          if (modalReady.current) sendOpen(id);
          else queuedClassId.current = id;
          setModalOpen(true);
        }
        return;
      }

      // fromModal
      if (d.type === "timeify:modal:ready") {
        modalReady.current = true;
        if (queuedClassId.current) {
          sendOpen(queuedClassId.current);
          queuedClassId.current = null;
        }
      } else if (d.type === "timeify:modal:close") {
        setModalOpen(false);
      } else if (d.type === "timeify:modal:booked") {
        // A modál nyitva marad (a visszaigazolást el kell olvasni), de a lista
        // mögötte frissüljön: változott a szabad helyek száma.
        listRef.current?.contentWindow?.postMessage(
          { type: "timeify:embed:refresh", slug },
          target,
        );
      }
    };

    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [target, slug]);

  // Görgetés-zár + görgetősáv-kompenzáció: az overflow:hidden eltünteti a
  // scrollbart, amitől a viewport ~15px-szel szélesebb lesz és az egész oldal
  // (a fejléc is) elcsúszik. A sáv szélességét paddinggal pótoljuk.
  useEffect(() => {
    if (!modalOpen) return;

    const prevOverflow = document.body.style.overflow;
    const prevPadding = document.body.style.paddingRight;
    const gutter = window.innerWidth - document.documentElement.clientWidth;
    if (gutter > 0) {
      const current = parseFloat(getComputedStyle(document.body).paddingRight) || 0;
      document.body.style.paddingRight = `${current + gutter}px`;
    }
    document.body.style.overflow = "hidden";

    // Ha a fókusz az iframe-ben van, ezt nem kapjuk meg — az ESC-et a modál
    // iframe is kezeli. Ez csak a mi oldalunkon lévő fókusz esetére kell.
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") closeModal();
    };
    window.addEventListener("keydown", onKey);

    return () => {
      document.body.style.overflow = prevOverflow;
      document.body.style.paddingRight = prevPadding;
      window.removeEventListener("keydown", onKey);
    };
  }, [modalOpen, closeModal]);

  return (
    <>
      {!mounted && (
        <div
          aria-hidden
          className="w-full animate-pulse rounded-xl bg-black/5"
          style={{ height, minHeight: 320 }}
        />
      )}

      {mounted && (
        <>
          {/* 1. lista — az oldal folyamában, soha nem mozdul */}
          <iframe
            ref={listRef}
            src={listSrc}
            title="Órarend"
            loading="lazy"
            scrolling="no"
            className="relative block w-full border-0"
            style={{
              height,
              minHeight: 320,
              background: "transparent",
              overflow: "hidden",
            }}
            allowTransparency
          />

          {/* 2. modál — előre betöltve, rejtve; kattintásra azonnal megjelenik */}
          <iframe
            ref={modalRef}
            src={modalSrc}
            title="Foglalás"
            className="fixed inset-0 z-[100] h-full w-full border-0"
            style={{
              display: modalOpen ? "block" : "none",
              background: "transparent",
            }}
            allowTransparency
          />
        </>
      )}
    </>
  );
}
